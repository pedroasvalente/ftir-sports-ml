RANDOM_SEED=52
GLOBAL_THRESHOLD_ACC=70

# DagsHub — optional. Without this, MLflow tracks locally in mlruns/
# Get token from: https://dagshub.com/user/settings/tokens
DAGSHUB_USER_TOKEN=
DAGSHUB_REPO_OWNER=pedroasvalente
DAGSHUB_REPO_NAME=ftir-sports-ml

# Set to DEBUG to enable verbose MLflow output
MLFLOW_LOGGING_LEVEL=
